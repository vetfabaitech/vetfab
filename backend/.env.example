# Copy this file to .env and adjust as needed.
# Only /api/v1/project/* requires a session (see JWT_SECRET below and
# app/api/deps.py) -- every other route on this backend is still open, same
# as before. Waveforms are served directly by this backend (see GET
# /api/v1/waveform/{jobId}/raw).

HOST=0.0.0.0
PORT=8000

# Comma-separated list of origins allowed to call this API / open websockets.
# Must match where the frontend dev server actually runs (see frontend/.env.local).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Docker image used for every compile+simulate run (see backend/docker/README.md
# for how to build it). Requires Docker Desktop/daemon running locally.
# Ships both Verilator (default engine) and Icarus Verilog (kept for
# backward compatibility) -- see app/services/simulators/.
DOCKER_IMAGE=hdl-webide-iverilog:latest
DOCKER_WORKDIR=/workspace
# 45s: Verilator's --binary step (verilate + g++/make) is slower than
# iverilog's near-instant bytecode compile. Raise further for large designs.
DOCKER_EXEC_TIMEOUT=45
# 1g: Verilator's C++ build needs more headroom than iverilog ever did;
# 256m risks the build being OOM-killed on non-trivial designs.
DOCKER_MEM_LIMIT=1g

# --- Session verification -----------------------------------------------
# This backend never issues a session -- ../log-in/backend does, on
# successful GitHub/Google sign-in. Copy that service's JWT_SECRET/
# JWT_ALGORITHM here verbatim; a mismatch means every request from a
# signed-in user fails auth (see app/api/deps.py).
JWT_SECRET=
JWT_ALGORITHM=HS256

# --- Supabase (relational metadata only -- projects/folders/files rows) ----
# Project URL and keys, from Supabase dashboard -> Project Settings -> API.
# SUPABASE_URL / SUPABASE_ANON_KEY: safe for client use (RLS-restricted).
# SUPABASE_SERVICE_ROLE_KEY: full-privilege, backend-only -- bypasses RLS.
# NEVER expose the service role key to the frontend or commit it.
# Run supabase_setup.sql then supabase_migration_s3_storage.sql (in that
# order) in the Supabase SQL editor before starting the backend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AWS S3 (every project file's actual content) ---------------------------
# IAM user/role credentials scoped to the one bucket below only.
# NEVER expose these to the frontend -- uploads/downloads go through this
# backend, not direct client-side AWS credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
# Key prefix every object is written under (projects/{id}/files/{nodeId}/vN).
S3_PREFIX=projects
# Only needed for non-AWS S3-compatible storage (e.g. Cloudflare R2, MinIO,
# Supabase Storage's S3-compatible endpoint). Leave blank for real AWS S3 --
# a bucket-specific virtual-hosted URL here will break requests (the bucket
# name would be duplicated in the path, since it's also passed per-call).
S3_ENDPOINT_URL=

# --- Verilog/SystemVerilog language intelligence -----------------------
# Real on-disk workspace directories (one per open project) backing
# svlangserver/Verilator/Verible/Surelog. These are native Linux tools --
# see backend/Dockerfile -- so this only works when the backend itself runs
# on Linux/WSL or inside that image; a plain `uvicorn` run on Windows will
# 500 on /lint, /format, /reindex, and /ws/lsp (but /workspace/* still works,
# since that's pure filesystem I/O).
LSP_WORKSPACE_ROOT=./data/workspaces
SVLANGSERVER_CMD=svlangserver
VERILATOR_CMD=verilator
VERIBLE_FORMAT_CMD=verible-verilog-format
SURELOG_CMD=surelog
LSP_IDLE_TIMEOUT=1800
VERILATOR_DEBOUNCE_MS=800
VERILATOR_TIMEOUT=20
SURELOG_TIMEOUT=60
VERIBLE_TIMEOUT=15
