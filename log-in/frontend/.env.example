# Copy to .env.local and fill in real values when this page gets wired up
# to a real backend. Nothing in src/ reads these for actual network calls
# yet -- see src/lib/mockAuth.ts, which simulates every auth flow locally.
# These exist now so the integration points are already named and in place.

# Base URL of the auth/API backend (see ../backend/.env.example for the
# server-side counterpart of this contract).
VITE_API_BASE_URL=http://localhost:8010

# Where the browser is sent to start each OAuth flow, and the client id
# each provider issues for this app. Secrets (client *secret*, signing
# keys) belong ONLY in the backend's .env -- never in a VITE_-prefixed
# variable, since anything with that prefix is bundled into the shipped
# JS and is publicly readable.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5174/auth/callback/google

VITE_GITHUB_CLIENT_ID=
VITE_GITHUB_OAUTH_REDIRECT_URI=http://localhost:5174/auth/callback/github

# Where a successful login redirects to by default (overridden by a
# `?redirect=` param when the user was bounced here from a protected page).
VITE_APP_URL=http://localhost:3000

# Keep "true" until the backend endpoints in ../backend are actually
# implemented -- flips LoginForm/OAuthButtons from mockAuth.ts over to
# real fetch() calls against VITE_API_BASE_URL once wired.
VITE_ENABLE_MOCK_AUTH=true
