# Copy to .env.local and fill in real values. The GitHub flow (see
# src/lib/realAuth.ts) is wired to a real backend; email/password and
# Google still go through src/lib/mockAuth.ts.
#
# Local dev: each service runs on its own port with no reverse proxy in
# front, so set the explicit absolute URLs below.
#
# Production behind Nginx: VITE_API_BASE_URL and VITE_APP_URL can both be
# LEFT UNSET -- realAuth.ts and AuthCallbackPage/CompleteProfilePage fall
# back to same-origin relative URLs (/auth, window.location.origin) that
# already match a reverse proxy serving this app, the main app, and both
# backends off path prefixes of one domain (/, /login/, /api/, /auth/).
#
# VITE_GOOGLE_OAUTH_REDIRECT_URI / VITE_GITHUB_OAUTH_REDIRECT_URI DO need
# an explicit production value, and must include the /login/ prefix this
# app is served under there (e.g. https://<domain>/login/auth/callback/github)
# -- they're also what's registered as each OAuth app's callback URL with
# GitHub/Google, and must match the backend's GITHUB_REDIRECT_URI/
# GOOGLE_REDIRECT_URI (see ../backend/.env.example) exactly.

# Base URL of the auth/API backend (see ../backend/.env.example for the
# server-side counterpart of this contract).
VITE_API_BASE_URL=http://localhost:8010

# Where the browser is sent to start each OAuth flow, and the client id
# each provider issues for this app. Secrets (client *secret*, signing
# keys) belong ONLY in the backend's .env -- never in a VITE_-prefixed
# variable, since anything with that prefix is bundled into the shipped
# JS and is publicly readable.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5174/auth/callback/google

VITE_GITHUB_CLIENT_ID=
VITE_GITHUB_OAUTH_REDIRECT_URI=http://localhost:5174/auth/callback/github

# Where a successful login redirects to by default (overridden by a
# `?redirect=` param when the user was bounced here from a protected page).
VITE_APP_URL=http://localhost:3000

# Keep "true" until the backend endpoints in ../backend are actually
# implemented -- flips LoginForm/OAuthButtons from mockAuth.ts over to
# real fetch() calls against VITE_API_BASE_URL once wired.
VITE_ENABLE_MOCK_AUTH=true
