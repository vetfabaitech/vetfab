# Copy to .env when wiring this up for real. Every endpoint in
# app/api/auth.py currently returns 501 regardless of these values -- see
# that file's module doc for what each one will be used for once it's not
# a stub anymore.

HOST=0.0.0.0
PORT=8010

# Must include wherever the frontend actually runs (see
# ../frontend/.env.example's VITE_APP_URL for the matching value).
CORS_ORIGINS=http://localhost:5174,http://localhost:3000

# -- Session / JWT --------------------------------------------------------
# Generate a real secret before this is ever wired up -- e.g.
# `openssl rand -hex 32`. Never commit a real value.
JWT_SECRET=CHANGE_ME_INSECURE_DEV_ONLY
JWT_ALGORITHM=HS256
# 24 hours -- users must sign back in with their provider (Google/GitHub)
# after this. Must match ../../backend/.env's JWT_ALGORITHM (that backend
# verifies this same token, see its app/api/deps.py).
JWT_EXPIRES_MINUTES=1440

# -- Google OAuth (console.cloud.google.com -> APIs & Services -> Credentials) --
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5174/auth/callback/google

# -- GitHub OAuth (github.com/settings/developers -> OAuth Apps) ---------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5174/auth/callback/github

# Where a successful login redirects the browser to.
FRONTEND_URL=http://localhost:3000

# -- User store: Supabase Postgres ------------------------------------------
# SAME project as ../../backend/.env's SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY
# -- the `users` table lives alongside that backend's projects/folders/files.
# Copy those two values here. See app/services/user_service.py.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of the main WebIDE backend (../../backend) -- used once, by
# app/services/project_bootstrap.py, to create a new user's first project
# via that backend's own POST /api/v1/project/save.
MAIN_API_URL=http://localhost:8000
